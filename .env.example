# Copy to .env (which is gitignored) and edit:  cp .env.example .env
# These defaults are for local development only. Never commit real secrets.

# Development behavior (warn instead of fail on the "changethis" defaults below)
FASTAPI_ENV=development

PROJECT_NAME="Badminton Rally Analyzer"

# Signs login tokens. For anything public generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis

# Admin account created on first start (scripts/prestart.sh)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (password reset) go to Mailpit locally: http://localhost:8025
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres (Docker). Host port 5433 so it doesn't clash with a local Postgres on 5432.
POSTGRES_PASSWORD=changethis
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/app
TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/app_test

# Uploaded videos (default: storage/ in the repo)
# STORAGE_DIR=/path/to/storage
